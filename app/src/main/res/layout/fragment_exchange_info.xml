<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:background="@drawable/bg_white">

    <!-- Menggunakan ScrollView agar konten dapat digulir -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="4dp"
        android:layout_marginStart="16dp"
        android:layout_marginEnd="16dp">

        <!-- Konten untuk Info Uang -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <!-- Gambar actbar.png -->
            <ImageView
                android:layout_width="match_parent"
                android:layout_height="163dp"
                android:scaleType="fitXY"
                android:src="@drawable/actbar" />

            <!-- Syarat -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="TENTANG"
                android:textSize="24sp"
                android:textColor="#333333"
                android:textStyle="bold"
                android:gravity="center"
                android:layout_marginTop="24dp"
                android:layout_marginBottom="24dp"
                android:fontFamily="sans-serif-medium" />

            <!-- Deskripsi Pendahuluan -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Money Damage Checker adalah sebuah aplikasi yang dirancang untuk membantu pengguna mengetahui apakah uang kertas Rupiah yang cacat atau rusak masih dapat ditukarkan di Bank Indonesia dengan nilai nominal yang sama. Aplikasi ini menggunakan teknologi deep learning, khususnya metode Convolutional Neural Network (CNN), untuk mendeteksi nominal uang kertas serta mengukur kondisi fisik uang berdasarkan persentase keutuhan yang terlihat."
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textColor="#333333"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif-medium" />

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Dengan memanfaatkan teknik pengolahan citra (image processing) melalui OpenCV, aplikasi ini dapat mengidentifikasi uang kertas yang rusak, seperti robek atau terpotong, dan menghitung berapa persen dari uang tersebut yang masih utuh. Berdasarkan aturan Bank Indonesia, uang yang cacat atau rusak dapat ditukar dengan nominal yang sama jika tingkat keutuhannya melebihi 2/3 bagian, atau setidaknya 67%. Aplikasi ini memberikan hasil klasifikasi otomatis yang menunjukkan apakah uang tersebut memenuhi syarat untuk ditukar atau tidak."
                android:layout_marginBottom="12dp"
                android:textSize="18sp"
                android:textColor="#333333"
                android:lineSpacingExtra="6dp"
                android:fontFamily="sans-serif-medium" />

        </LinearLayout>
    </ScrollView>
</FrameLayout>
