<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:scaleType="centerCrop"
    android:background="@drawable/bg_white"
    tools:context=".ResultActivity">

    <!-- Original Image Display -->
    <ImageView
        android:id="@+id/originalImageView"
        android:layout_width="match_parent"
        android:layout_height="344dp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="16dp"
        android:contentDescription="Original Image"
        android:scaleType="centerInside" />

    <!-- Percentage Text -->
    <TextView
        android:id="@+id/percentageTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/originalImageView"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:text="FISIK UANG : "
        android:textSize="16sp"
        android:textColor="@android:color/black" />

    <!-- Classification Text -->
    <TextView
        android:id="@+id/classificationTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/percentageTextView"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"
        android:text="NOMINAL : "
        android:textSize="16sp"
        android:textColor="@android:color/black" />

    <!-- Eligibility Text -->
    <TextView
        android:id="@+id/eligibilityTextView"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/classificationTextView"
        android:layout_marginTop="8dp"
        android:layout_centerHorizontal="true"
        android:textSize="30sp"
        android:textColor="@android:color/black" />

    <!-- Retake Image Button -->
    <Button
        android:id="@+id/retakeImageButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/eligibilityTextView"
        android:layout_marginTop="16dp"
        android:layout_centerHorizontal="true"
        android:text="Ambil Gambar Ulang" />

</RelativeLayout>
